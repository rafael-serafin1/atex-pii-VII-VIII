@page
@model IndexModel
@{
    var wide = Model.Tela is "curso" or "aula" or "agenda" or "presenca";
    ViewData["Title"] = Model.Tela switch
    {
        "curso" => "Cadastro de Curso",
        "aula" => "Cadastro de Aula",
        "agenda" => "Dias de Curso",
        "presenca" => "Marcar Presença",
        _ => "Cadastro de Aluno"
    };
}

<header class="site-header">
    <div class="header-inner">
        <a class="brand" asp-page="/Index" asp-route-tela="aluno" aria-label="Arduino Fundamentals, início">
            <span class="board-icon" aria-hidden="true">
                <img src="~/arduino_board_icon.svg"/>
            </span>
            <span class="brand-copy">
                <strong>ARDUINO FUNDAMENTALS</strong>
                <small>
                    <img src="~/pin_icon.svg" class="pin-mark" aria-hidden="true" /> NAVCODE INSTITUTO DE TECNOLOGIA
                </small>
            </span>
        </a>
        <nav class="main-nav" aria-label="Navegação principal">
            <details class="nav-group">
                <summary class="nav-trigger @(Model.Tela == "agenda" ? "is-active" : "")">AULAS 
                    <span class="chevron" aria-hidden="true"></span>
                </summary>
                <div class="nav-menu">
                    <a class="@(Model.Tela == "agenda" ? "is-current" : "")" asp-page="/Index" asp-route-tela="agenda"><span></span>AGENDA</a>
                    <a class="@(Model.Tela == "presenca" ? "is-current" : "")" asp-page="/Index" asp-route-tela="presenca"><span></span>PRESENÇA</a>
                </div>
            </details>
            <details class="nav-group">
                <summary class="nav-trigger @(Model.Tela is "aluno" or "curso" or "aula" ? "is-active" : "")">CADASTRO 
                    <span class="chevron" aria-hidden="true"></span>
                </summary>
                <div class="nav-menu">
                    <a class="@(Model.Tela == "aluno" ? "is-current" : "")" asp-page="/Index" asp-route-tela="aluno"><span></span>ALUNO</a>
                    <a class="@(Model.Tela == "curso" ? "is-current" : "")" asp-page="/Index" asp-route-tela="curso"><span></span>CURSO</a>
                    <a class="@(Model.Tela == "aula" ? "is-current" : "")" asp-page="/Index" asp-route-tela="aula"><span></span>AULA</a>
                </div>
            </details>
        </nav>
    </div>
</header>

<main class="main-content">
    <section class="content-frame @(wide ? "content-frame-wide" : "")" aria-labelledby="page-title">
        <span class="corner corner-tl" aria-hidden="true"></span><span class="corner corner-tr" aria-hidden="true"></span>
        <span class="corner corner-bl" aria-hidden="true"></span><span class="corner corner-br" aria-hidden="true"></span>
        <div class="panel">
            <div class="panel-heading">
                <div class="panel-status">
                    <i class="status-green"></i>
                    <i class="status-blue"></i>
                    <i class="status-copper"></i>
                    <span></span>
                    <small>
                        @(Model.Tela switch { "curso" => "REG_CURSO_v1.0", "aula" => "REG_AULA_v1.0", "agenda" => "AGENDA_v1.0", "presenca" => "PRESENCA_v1.0", _ => "REG_ALUNO_v1.0" })
                    </small>
                </div>

                <h1 id="page-title">
                    @(Model.Tela switch { "curso" => "CADASTRO DE CURSO", "aula" => "CADASTRO DE AULA", "agenda" => "DIAS DE CURSO", "presenca" => "MARCAR PRESENÇA", _ => "CADASTRO DE ALUNO" })
                </h1>
                <p>
                    @(Model.Tela switch { "curso" => "Registre um novo curso no sistema da instituição.", "aula" => "Programe uma nova aula para um curso cadastrado.", "agenda" => "Cursos cadastrados e suas aulas programadas.", "presenca" => "Selecione a aula e marque manualmente a situação de cada aluno cadastrado.", _ => "Preencha os dados para confirmar sua inscrição no curso." })
                </p>
            </div>

            @if (Model.CadastroConcluido)
            {
                <section class="success-panel" role="status">
                    <img src="~/check_icon.svg" alt="Sucess"/>
                    <h2>@(Model.Tela switch { "aluno" => "INSCRIÇÃO CONFIRMADA", "presenca" => "PRESENÇA REGISTRADA", "curso" => "CURSO CADASTRADO", "aula" => "AULA CADASTRADO", _ => "CADASTRO CONCLUÍDO" })</h2>
                    <p>@Model.MensagemSucesso</p>
                    <a class="secondary-button" asp-page="/Index" asp-route-tela="@Model.Tela">@(Model.Tela == "presenca" ? "VOLTAR À PRESENÇA" : "NOVO CADASTRO")</a>
                </section>
            }
            else if (Model.Tela == "presenca")
            {
                <form method="post" asp-page-handler="MarcarPresenca" class="manual-presence-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <div class="field">
                        <label asp-for="AulaSelecionada">AULA <b>*</b></label>
                        <select asp-for="AulaSelecionada" class="input-field">
                            <option value="">Selecione a aula</option>
                            @foreach (var aula in Model.AulasCadastradas)
                            {
                                <option value="@aula.Id">@aula.Titulo - @aula.DataAula.ToString("dd/MM/yyyy HH:mm")</option>
                            }
                        </select>
                        <span asp-validation-for="AulaSelecionada" class="field-error"></span>
                    </div>
                    @if (Model.AlunosCadastrados.Count == 0)
                    {
                        <p class="agenda-empty">Nenhum aluno cadastrado.</p>
                    }
                    else
                    {
                        <div class="manual-presence-list">
                            <div class="manual-presence-header">
                                <span>ALUNO</span>
                                <span>OBSERVAÇÃO DA AUSÊNCIA</span>
                                <span>PRESENTE</span>
                            </div>
                            @foreach (var aluno in Model.AlunosCadastrados)
                            {
                                <div class="manual-presence-row">
                                    <span>
                                        <strong>@aluno.Nome @aluno.Sobrenome</strong>
                                        <small>@aluno.Email</small>
                                    </span>
                                    <textarea class="input-field absence-observation" name="Observacoes[@aluno.Id]" maxlength="150" placeholder="Ex: falta justificada" data-absence-observation="@aluno.Id"></textarea>
                                    <label class="presence-checkbox">
                                        <input type="checkbox" name="AlunosPresentes" value="@aluno.Id" aria-label="Marcar aluno como presente" data-presence-checkbox="@aluno.Id" />
                                    </label>
                                </div>
                            }
                        </div>
                        <button class="submit-button" type="submit">SALVAR CHAMADA</button>
                    }
                </form>
            }
            else if (Model.Tela == "aluno")
            {
                <form method="post" asp-page-handler="CadastrarAluno" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <div class="trace-label">IDENTIFICAÇÃO</div>
                    <div class="form-grid student-grid">
                        <div class="field"><label asp-for="Aluno.Nome">NOME <b>*</b></label><input asp-for="Aluno.Nome" class="input-field" autocomplete="given-name"/><span asp-validation-for="Aluno.Nome" class="field-error"></span></div>
                        <div class="field"><label asp-for="Aluno.Sobrenome">SOBRENOME <b>*</b></label><input asp-for="Aluno.Sobrenome" class="input-field" autocomplete="family-name"/><span asp-validation-for="Aluno.Sobrenome" class="field-error"></span></div>
                    </div>
                    <div class="trace-label">CONTATO</div>
                    <div class="field-stack">
                        <div class="field"><label asp-for="Aluno.Email">E-MAIL<b>*</b></label><input asp-for="Aluno.Email" class="input-field" type="email" autocomplete="email"/><span asp-validation-for="Aluno.Email" class="field-error"></span></div>
                        <div class="field"><label asp-for="Aluno.Telefone">TELEFONE <small>(OPCIONAL)</small></label><input asp-for="Aluno.Telefone" class="input-field" type="tel" autocomplete="tel"/></div>
                    </div>
                    <button class="submit-button" type="submit">CONFIRMAR INSCRIÇÃO</button>
                    <p class="form-note">* Campos obrigatórios</p>
                </form>
            }
            else if (Model.Tela == "curso")
            {
                <form method="post" asp-page-handler="CadastrarCurso" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <div class="trace-label">IDENTIFICAÇÃO DO CURSO</div>
                    <div class="field">
                        <label asp-for="Curso.Nome">NOME DO CURSO <b>*</b></label>
                        <input asp-for="Curso.Nome" class="input-field" placeholder="Ex: Arduino para Iniciantes"/>
                        <span asp-validation-for="Curso.Nome" class="field-error"></span>
                    </div>
                    <div class="field course-description">
                        <label asp-for="Curso.Descricao">DESCRIÇÃO <small>(OPCIONAL)</small></label><textarea asp-for="Curso.Descricao" class="input-field" placeholder="Descreva brevemente o conteúdo e objetivos do curso..." rows="3"></textarea></div>
                    <div class="trace-label">CONFIGURAÇÃO</div>
                    <div class="form-grid course-config-grid">
                        <div class="field"><label asp-for="Curso.DataApresentacao">DATA DE APRESENTAÇÃO <b>*</b></label><input asp-for="Curso.DataApresentacao" class="input-field" type="date"/><span asp-validation-for="Curso.DataApresentacao" class="field-error"></span></div>
                        <div class="field"><label asp-for="Curso.TempoApresentacao">DURAÇÃO (min) <b>*</b></label><input asp-for="Curso.TempoApresentacao" class="input-field" type="number" min="1" placeholder="Ex: 40"/><span asp-validation-for="Curso.TempoApresentacao" class="field-error"></span></div>
                    </div>
                    <button class="submit-button" type="submit">CADASTRAR CURSO</button>
                    <p class="form-note">* Campos obrigatórios</p>
                </form>
            }
            else if (Model.Tela == "aula")
            {
                <form method="post" asp-page-handler="CadastrarAula" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <div class="trace-label">VÍNCULO DA AULA</div>
                    <div class="field">
                        <label asp-for="Aula.IdCurso">CURSO <b>*</b></label>
                        <select asp-for="Aula.IdCurso" class="input-field">
                            <option value="">Selecione o curso</option>
                            @foreach (var curso in Model.CursosCadastrados)
                            {
                                <option value="@curso.Id">@curso.Nome</option>
                            }
                        </select>
                        <span asp-validation-for="Aula.IdCurso" class="field-error"></span>
                    </div>
                    <div class="trace-label">DADOS DA AULA</div>
                    <div class="field">
                        <label asp-for="Aula.Titulo">TÍTULO <b>*</b></label>
                        <input asp-for="Aula.Titulo" class="input-field" placeholder="Ex: Introdução ao Arduino" />
                        <span asp-validation-for="Aula.Titulo" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Aula.DataAula">DATA E HORA <b>*</b></label>
                        <input asp-for="Aula.DataAula" class="input-field" type="datetime-local" />
                        <span asp-validation-for="Aula.DataAula" class="field-error"></span>
                    </div>
                    @if (Model.CursosCadastrados.Count == 0)
                    {
                        <p class="agenda-empty">Cadastre um curso antes de cadastrar uma aula.</p>
                    }
                    else
                    {
                        <button class="submit-button" type="submit">CADASTRAR AULA</button>
                    }
                </form>
            }
            else if (Model.Tela == "agenda")
            {
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                @if (Model.AgendaCursos.Count == 0 && ViewData.ModelState.IsValid)
                {
                    <p class="agenda-empty">Nenhum curso cadastrado.</p>
                }
                else
                {
                    <div class="agenda-grid">
                    @foreach (var item in Model.AgendaCursos)
                    {
                        <article class="lesson-card course-agenda-card">
                            <span class="lesson-number">CURSO @item.Curso.Id.ToString("00")</span>
                            <h2>@item.Curso.Nome</h2>
                            @if (!string.IsNullOrWhiteSpace(item.Curso.Descricao))
                            {
                                <p class="lesson-summary">@item.Curso.Descricao</p>
                            }
                            <div class="card-divider"></div>
                            <div class="lesson-card-bottom">
                                <div class="lesson-meta">
                                    <span><i class="calendar-icon" aria-hidden="true"></i>Apresentação: @item.Curso.DataApresentacao.ToString("dd/MM/yyyy")</span>
                                    <span><i class="clock-icon" aria-hidden="true"></i>@item.Curso.TempoApresentacao h</span>
                                </div>
                            </div>
                            @if (item.Aulas.Count == 0)
                            {
                                <p class="lesson-summary">Nenhuma aula cadastrada.</p>
                            }
                            else
                            {
                                <ol class="course-lesson-list">
                                @foreach (var aula in item.Aulas)
                                {
                                    <li>
                                        <strong>@aula.Titulo</strong>
                                        <span>@aula.DataAula.ToString("dd/MM/yyyy HH:mm")</span>
                                    </li>
                                }
                                </ol>
                            }
                        </article>
                    }
                    </div>
                }
            }
            else
            {
                <div class="presenca-grid">
                    
                </div>
            }
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="footer-inner"><p>© 2026 NavCode Instituto de Tecnologia</p></div>
</footer>
